# ===== OLLAMA CLIENT CONFIGURATION =====
# These are defaults for client applications connecting to the local Ollama server.
# Adjust as needed for your use case.

# OLLAMA_MODEL=llama3
OLLAMA_MODEL=qwen3-vl:latest
# Vision model alternative (for image inputs): OLLAMA_MODEL=qwen3-vl:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL_TEMPERATURE=0.2
OLLAMA_MODEL_NUM_CTX=8192
OLLAMA_MODEL_NUM_PREDICT=2048
OLLAMA_MODEL_TOP_K=40
OLLAMA_MODEL_TOP_P=0.85
OLLAMA_MODEL_SEED=42

# ===== OLLAMA PERFORMANCE TUNING =====
# Adjust these for better performance/quality trade-offs

# Context window size (larger = more memory, can handle longer inputs)
OLLAMA_NUM_CTX=8192

# Maximum tokens to predict in a response (stop after this many)
OLLAMA_NUM_PREDICT=2048

# Temperature for randomness (0.0 = deterministic, 1.0 = very creative)
OLLAMA_TEMPERATURE=0.2

# Top-k sampling (limits next token choices to top k)
OLLAMA_TOP_K=40

# Top-p sampling (nucleus sampling; 0.9 = keep 90% probability mass)
OLLAMA_TOP_P=0.85

# Repeat penalty to reduce loops (1.0 = no penalty, >1.0 penalize repeats)
OLLAMA_REPEAT_PENALTY=1.1

# Presence penalty to encourage new topics (0.0 = none, >0.0 penalize presence)
OLLAMA_PRESENCE_PENALTY=0.0

# Frequency penalty to reduce word repetition (0.0 = none, >0.0 penalize frequency)
OLLAMA_FREQUENCY_PENALTY=0.0

# Mirostat sampling for consistent quality (0 = off, 1 = Mirostat, 2 = Mirostat 2.0)
OLLAMA_MIROSTAT=0

# Mirostat target entropy (controls perplexity; 5.0 is typical)
OLLAMA_MIROSTAT_TAU=5.0

# Mirostat learning rate (0.1 to 0.3 typical)
OLLAMA_MIROSTAT_ETA=0.1

# ===== OLLAMA SERVER SETTINGS =====
# These affect the Ollama server when started via Docker Compose

# Maximum number of concurrent requests (adjust based on your hardware)
OLLAMA_MAX_QUEUE=512

# Maximum number of models to keep loaded in memory
OLLAMA_MAX_LOADED_MODELS=2

# Number of parallel request handlers
OLLAMA_NUM_PARALLEL=2

# Keep models loaded after request (true = faster repeated calls, uses more VRAM)
OLLAMA_KEEP_ALIVE=30m

# Optional: Uncomment to skip TLS verification (not needed for local)
# OLLAMA_INSECURE=true

# Optional: Uncomment if you use a proxy
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1
